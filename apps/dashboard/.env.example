# Dashboard environment
PORT=3000
NODE_ENV=development

AUTH_USERNAME=ede
# Generate with: node -e "const {scryptSync,randomBytes}=require('crypto');const s=randomBytes(16).toString('hex');console.log('SALT='+s);console.log('AUTH_PASSWORD_HASH='+scryptSync('your-password',s,64).toString('hex'));"
AUTH_PASSWORD_SALT=replace-with-random-salt
AUTH_PASSWORD_HASH=replace-with-scrypt-hash

SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

NETWORK_AGENT_URL=http://127.0.0.1:3100
INTERNAL_AGENT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

ACTIVE_SCAN_ENABLED=true
