# Network Agent environment
AGENT_PORT=3100
INTERNAL_AGENT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

DEVICES_FILE_PATH=./data/devices.json

LAN_INTERFACE=eth0
LAN_CIDR=192.168.0.0/24
WOL_BROADCAST_ADDRESS=192.168.0.255
WOL_PORT=9
WOL_NUM_PACKETS=3
WOL_PACKET_INTERVAL_MS=100

ACTIVE_SCAN_ENABLED=true
ACTIVE_SCAN_TIMEOUT_MS=15000

SECURITY_ALERT_EMAIL=recipient@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=username
SMTP_PASSWORD=password
SMTP_FROM=home-dashboard@example.com
