    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@home-dashboard/contracts": "workspace:*",
    "fastify": "^5.4.0",
    "nodemailer": "^7.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.16.0",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.30.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
